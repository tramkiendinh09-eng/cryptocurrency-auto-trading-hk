# Python Worker 生产环境变量示例
# 复制为 .env 后按实际部署修改；不要把真实密钥提交到仓库。

# 运行入口：trade_runtime 是当前唯一推荐的 worker 模式。
WORKER_PROFILE=trade_runtime
WORKER_ID=trade-runtime-1
TRADE_RUNTIME_WORKER_ID=
TRADE_RUNTIME_LOG_LEVEL=INFO

# 控制端连接：Docker Compose 内使用 dca-backend 服务名。
TRADE_RUNTIME_BASE_URL=http://dca-backend:8080
TRADE_RUNTIME_BEARER_TOKEN=
BACKEND_API_URL=http://dca-backend:8080

# 运行模式：forever 持续轮询；once 单次执行；replay 需填写 TRADE_RUNTIME_REPLAY_TRACE_ID。
TRADE_RUNTIME_RUN_MODE=forever
TRADE_RUNTIME_REPLAY_TRACE_ID=
TRADE_RUNTIME_DEFAULT_SYMBOL=BTCUSDT
TRADE_RUNTIME_POLL_INTERVAL_SECONDS=15
TRADE_RUNTIME_MODEL_CALL_TIMEOUT_SECONDS=45

# 辅助源 HTTP 拉取超时（秒）：全局默认 15 秒；单源变量为空时继承全局值。
# onchain/social 常比行情慢，生产环境可单独调大，如 30-60。
TRADE_RUNTIME_AUX_FEED_TIMEOUT_SECONDS=15
TRADE_RUNTIME_NEWS_FEED_TIMEOUT_SECONDS=
TRADE_RUNTIME_ONCHAIN_FEED_TIMEOUT_SECONDS=
TRADE_RUNTIME_SOCIAL_FEED_TIMEOUT_SECONDS=

# Redis 基础连接：TRADE_RUNTIME_REDIS_* 为空时会回退到 REDIS_*。
REDIS_HOST=redis-host.example.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
TRADE_RUNTIME_REDIS_HOST=redis-host.example.internal
TRADE_RUNTIME_REDIS_PORT=6379
TRADE_RUNTIME_REDIS_DB=0
TRADE_RUNTIME_REDIS_PASSWORD=

# 事件流配置：TRADE_RUNTIME_STREAM_NAME 为空时禁用 Redis stream。
TRADE_RUNTIME_STREAM_NAME=trade.runtime.events
TRADE_RUNTIME_STREAM_GROUP=trade-runtime.persist
TRADE_RUNTIME_STREAM_CONSUMER=
TRADE_RUNTIME_STREAM_DLQ=trade.runtime.events.dlq
TRADE_RUNTIME_STREAM_MAX_RETRIES=3
TRADE_RUNTIME_STREAM_DEDUPE_TTL_SECONDS=86400

# 市场上下文与长期记忆：用于补齐模型判断所需的历史样本。
TRADE_RUNTIME_INITIAL_MARKET_HISTORY_JSON=
TRADE_RUNTIME_MARKET_CONTEXT_HISTORY_LIMIT=60
TRADE_RUNTIME_MARKET_CONTEXT_HISTORY_MAX_AGE_MINUTES=300
TRADE_RUNTIME_MEMORY_WINDOW_SECONDS=7200

# OpenAI 兼容直连配置：仅在本地脚本或控制端透传直连时使用。
OPENAI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4

# 邮件与旧采集脚本配置：未启用对应功能时可留空。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_ADDRESS=
BINANCE_API_KEY=
BINANCE_API_SECRET=
ETHERSCAN_API_KEY=

# 实盘注意：交易所 API Key/Secret 必须在后端账户绑定中配置，worker 不读取 .env 中的交易所凭据下单。

[Unit]
Description=DCA decision runtime worker (LangGraph)
After=network-online.target dca-backend.service dca-feed-adapter.service redis-server.service
Wants=network-online.target
Requires=dca-backend.service

[Service]
Type=simple
User=dca
Group=dca
WorkingDirectory=/opt/dca/app/python-worker
EnvironmentFile=/opt/dca/env/worker.env
# After=dca-backend only means the unit started, not that Spring Boot is
# listening — it needs ~20s. Without this the first bootstrap fetch dies on
# connection-refused and the worker restarts into a crash loop until it wins
# the race.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do wget -q -O /dev/null "$TRADE_RUNTIME_BASE_URL/dca/callback/health" && exit 0; sleep 2; done; echo "backend not ready after 120s" >&2; exit 1'
ExecStart=/opt/dca/venv/bin/python main.py
Restart=always
RestartSec=15s

# The worker is the only component that can place orders. If it dies repeatedly,
# stop restarting it rather than hammering the exchange with a broken build.
StartLimitIntervalSec=300
StartLimitBurst=5

MemoryMax=768M
TasksMax=256

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/dca/logs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=append:/opt/dca/logs/worker.log
StandardError=append:/opt/dca/logs/worker.log

[Install]
WantedBy=multi-user.target

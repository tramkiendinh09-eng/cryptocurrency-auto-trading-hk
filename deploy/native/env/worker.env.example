# Decision-runtime worker. Install to /opt/dca/env/worker.env, chmod 600.
#
# The worker holds NO exchange credentials. It asks the control plane to place
# orders, and the control plane reads the key material from the bound exchange
# account. Keep it that way: a compromised worker should not be able to trade.

WORKER_PROFILE=trade_runtime
WORKER_ID=trade-runtime-1
TRADE_RUNTIME_LOG_LEVEL=INFO

# --- control plane ---
TRADE_RUNTIME_BASE_URL=http://127.0.0.1:18081
BACKEND_API_URL=http://127.0.0.1:18081
TRADE_RUNTIME_BEARER_TOKEN=__CHANGE_ME__

# --- run mode ---
# forever = long-running poller. Keep REPLAY_TRACE_ID empty here; one-shot
# replays are a separate invocation with TRADE_RUNTIME_RUN_MODE=replay.
TRADE_RUNTIME_RUN_MODE=forever
TRADE_RUNTIME_REPLAY_TRACE_ID=
TRADE_RUNTIME_DEFAULT_SYMBOL=BTCUSDT
TRADE_RUNTIME_POLL_INTERVAL_SECONDS=15
TRADE_RUNTIME_MODEL_CALL_TIMEOUT_SECONDS=45

# --- auxiliary feeds ---
# onchain/social are slower than market data; give them room.
TRADE_RUNTIME_AUX_FEED_TIMEOUT_SECONDS=15
TRADE_RUNTIME_ONCHAIN_FEED_TIMEOUT_SECONDS=45
TRADE_RUNTIME_SOCIAL_FEED_TIMEOUT_SECONDS=45

# --- redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=__CHANGE_ME__
TRADE_RUNTIME_REDIS_HOST=127.0.0.1
TRADE_RUNTIME_REDIS_PORT=6379
TRADE_RUNTIME_REDIS_DB=0
TRADE_RUNTIME_REDIS_PASSWORD=__CHANGE_ME__

# --- event stream ---
TRADE_RUNTIME_STREAM_NAME=trade.runtime.events
TRADE_RUNTIME_STREAM_GROUP=trade-runtime.persist
TRADE_RUNTIME_STREAM_DLQ=trade.runtime.events.dlq
TRADE_RUNTIME_STREAM_MAX_RETRIES=3
TRADE_RUNTIME_STREAM_DEDUPE_TTL_SECONDS=86400

# --- market context ---
TRADE_RUNTIME_MARKET_CONTEXT_HISTORY_LIMIT=60
TRADE_RUNTIME_MARKET_CONTEXT_HISTORY_MAX_AGE_MINUTES=300
TRADE_RUNTIME_MEMORY_WINDOW_SECONDS=7200

# --- long-term memory (optional MemOS MCP) ---
TRADE_RUNTIME_MEMORY_STORE=short_term
TRADE_RUNTIME_MEMOS_MCP_URL=

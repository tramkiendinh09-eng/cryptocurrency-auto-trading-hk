# Auxiliary feed adapter. Install to /opt/dca/env/feed-adapter.env, chmod 600.

# Loopback only: the control plane and the worker are the sole consumers.
FEED_ADAPTER_HOST=127.0.0.1
FEED_ADAPTER_PORT=18080
FEED_ADAPTER_REQUEST_TIMEOUT_SECONDS=8
FEED_ADAPTER_USER_AGENT=dca-feed-adapter/1.0

# Refresh floors: keep these at or above the upstream cadence or you will simply
# collect rate-limit errors.
FEED_ADAPTER_NEWS_MIN_REFRESH_SECONDS=180
FEED_ADAPTER_ONCHAIN_MIN_REFRESH_SECONDS=300
FEED_ADAPTER_SOCIAL_MIN_REFRESH_SECONDS=300

FEED_ADAPTER_NEWS_FEED_URLS=["https://www.coindesk.com/arc/outboundfeeds/rss/"]
FEED_ADAPTER_SOCIAL_LISTING_URLS=["https://www.reddit.com/r/CryptoCurrency/new.json?limit=25","https://www.reddit.com/r/BitcoinMarkets/new.json?limit=25"]

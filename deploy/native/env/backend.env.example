# Control-plane environment. Install to /opt/dca/env/backend.env, chmod 600.
# Every value below overrides a placeholder in application.yml / application-druid.yml,
# so no credential ever has to be edited into a tracked file.

# --- listener ---
# Bind loopback only: nginx is the sole public surface.
SERVER_PORT=18081
JAVA_OPTS=-Xms256m -Xmx1024m -XX:+UseSerialGC -Djava.security.egd=file:/dev/urandom -Dserver.address=127.0.0.1

# --- upload dir ---
# application.yml defaults this to the Windows path D:/ruoyi/uploadPath.
RUOYI_PROFILE=/opt/dca/data/upload

# --- database ---
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/ai_trading?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=GMT%2B8
MYSQL_USERNAME=dca
MYSQL_PASSWORD=__CHANGE_ME__

# --- redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=__CHANGE_ME__

# --- JWT ---
# application.yml ships the literal default "abcdefghijklmnopqrstuvwxyz".
# Anyone who knows it can mint a valid admin token. Always override it.
TOKEN_SECRET=__CHANGE_ME__

# --- druid console ---
# statViewServlet is enabled with an empty allow-list upstream. nginx 404s the
# route, and these credentials are the second line of defence.
DRUID_USERNAME=dca-ops
DRUID_PASSWORD=__CHANGE_ME__

# --- logging ---
# logback.xml hardcodes /home/ruoyi/logs upstream; a missing appender directory
# is a fatal startup error, so point it somewhere this unit can actually write.
LOG_PATH=/opt/dca/logs
# Upstream default is `debug`, which logs every SQL statement including order flow.
LOG_LEVEL_RUOYI=info

# --- mail (optional; leave blank to keep the email channel disabled) ---
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SSL_TRUST=

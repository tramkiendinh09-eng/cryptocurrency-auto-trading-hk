<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.dca.mapper.trade.TradePositionGuardCrudMapper">

    <resultMap id="TradePositionGuardResult" type="com.ruoyi.dca.domain.trade.TradePositionGuard">
        <id property="id" column="id"/>
        <result property="guardName" column="guard_name"/>
        <result property="scopeType" column="scope_type"/>
        <result property="strategyId" column="strategy_id"/>
        <result property="symbol" column="symbol"/>
        <result property="exchangeCode" column="exchange_code"/>
        <result property="stopLossPct" column="stop_loss_pct"/>
        <result property="takeProfitPct" column="take_profit_pct"/>
        <result property="maxHoldingMinutes" column="max_holding_minutes"/>
        <result property="enabled" column="enabled"/>
        <result property="priority" column="priority"/>
        <result property="remark" column="remark"/>
        <result property="createdAt" column="create_time"/>
        <result property="updatedAt" column="update_time"/>
    </resultMap>

    <sql id="tradePositionGuardColumns">
        id, guard_name, scope_type, strategy_id, symbol, exchange_code, stop_loss_pct, take_profit_pct,
        max_holding_minutes, enabled, priority, remark, create_time, update_time
    </sql>

    <select id="selectTradePositionGuardList" parameterType="com.ruoyi.dca.domain.trade.TradePositionGuard" resultMap="TradePositionGuardResult">
        select <include refid="tradePositionGuardColumns"/>
        from trade_position_guard
        <where>
            <if test="guardName != null and guardName != ''">
                and guard_name like concat('%', #{guardName}, '%')
            </if>
            <if test="scopeType != null and scopeType != ''">
                and scope_type = #{scopeType}
            </if>
            <if test="strategyId != null">
                and strategy_id = #{strategyId}
            </if>
            <if test="symbol != null and symbol != ''">
                and symbol = #{symbol}
            </if>
            <if test="exchangeCode != null and exchangeCode != ''">
                and exchange_code = #{exchangeCode}
            </if>
            <if test="enabled != null">
                and enabled = #{enabled}
            </if>
        </where>
        order by priority asc, id desc
    </select>

    <select id="selectTradePositionGuardById" resultMap="TradePositionGuardResult">
        select <include refid="tradePositionGuardColumns"/>
        from trade_position_guard
        where id = #{id}
    </select>

    <insert id="insertTradePositionGuard" parameterType="com.ruoyi.dca.domain.trade.TradePositionGuard" useGeneratedKeys="true" keyProperty="id">
        insert into trade_position_guard (
            guard_name,
            scope_type,
            strategy_id,
            symbol,
            exchange_code,
            stop_loss_pct,
            take_profit_pct,
            max_holding_minutes,
            enabled,
            priority,
            remark
        ) values (
            #{guardName},
            #{scopeType},
            #{strategyId},
            #{symbol},
            #{exchangeCode},
            #{stopLossPct},
            #{takeProfitPct},
            #{maxHoldingMinutes},
            #{enabled},
            #{priority},
            #{remark}
        )
    </insert>

    <update id="updateTradePositionGuard" parameterType="com.ruoyi.dca.domain.trade.TradePositionGuard">
        update trade_position_guard
        <set>
            <if test="guardName != null">guard_name = #{guardName},</if>
            <if test="scopeType != null">scope_type = #{scopeType},</if>
            strategy_id = #{strategyId},
            symbol = #{symbol},
            exchange_code = #{exchangeCode},
            stop_loss_pct = #{stopLossPct},
            take_profit_pct = #{takeProfitPct},
            max_holding_minutes = #{maxHoldingMinutes},
            <if test="enabled != null">enabled = #{enabled},</if>
            <if test="priority != null">priority = #{priority},</if>
            remark = #{remark},
            update_time = now()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteTradePositionGuardByIds">
        delete from trade_position_guard
        where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
